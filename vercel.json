{
  "rewrites": [
    {
      "source": "/api/drive/status",
      "destination": "/api/drive-status"
    },
    {
      "source": "/api/drive/auth-url",
      "destination": "/api/drive-auth"
    },
    {
      "source": "/api/drive/initiate-video-upload",
      "destination": "/api/drive-initiate"
    },
    {
      "source": "/api/drive/initiate",
      "destination": "/api/drive-initiate"
    },
    {
      "source": "/api/drive/make-public",
      "destination": "/api/drive-make-public"
    },
    {
      "source": "/api/drive/delete",
      "destination": "/api/drive-delete"
    },
    {
      "source": "/api/drive/sync",
      "destination": "/api/drive-sync"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
